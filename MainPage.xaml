<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter.MainPage"
             Title="Counter">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label Text="Counter"
                   FontSize="32"
                   HorizontalOptions="Center"
                   FontAttributes="Bold" />

            <Entry x:Name="nameEntry"
                   Placeholder="Nazwa Licznika" />

            <Button Text="Dodaj Licznik"
                    Clicked="AddCounter_Clicked" />
            
            <BoxView HeightRequest="2"
                     Margin="0.1"
                     Color="Gray" />

            <Button Text="Zapisz"
                Clicked="SaveButton_Clicked" />

            <VerticalStackLayout x:Name="countersLayout"
                                 Spacing="15" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
